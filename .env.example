# AI Hub / Learning Tracker configuration
# Copy to .env on the server and change all secrets.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
AI_HUB_ADMIN_TOKEN=change-this-admin-token
AI_HUB_INTERNAL_TOKEN=change-this-internal-token
AI_HUB_MASTER_KEY=change-this-long-random-master-key

# Legacy direct-provider fallback for learning-tracker; normally configure providers in AI Hub UI instead.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
