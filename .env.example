# Optional overrides. docker-compose.yml already has runnable defaults.
# You do NOT need to put third-party model API URL/Key here; configure them in AI Hub Admin UI.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
AI_HUB_ADMIN_TOKEN=dev-admin-token
AI_HUB_INTERNAL_TOKEN=dev-internal-token
AI_HUB_MASTER_KEY=dev-master-key-change-me

# Optional MySQL overrides
MYSQL_ROOT_PASSWORD=ai_hub_root_password
DB_NAME=ai_hub
DB_USER=ai_hub
DB_PASSWORD=ai_hub_password

# Legacy direct-provider fallback for learning-tracker; normally leave empty.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
